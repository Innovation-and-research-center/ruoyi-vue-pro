## ==========================
## 核心路径配置 (macOS 绝对路径)
## ==========================

# 1. 文件上传存储路径 (您指定的路径)
FILE_PATH=/Users/louzeyu/Documents/oa_upload

# 2. Redis 数据持久化路径 (新增，建议与上传路径同级)
REDIS_DATA_PATH=/Users/louzeyu/Documents/oa_redis_data

## ==========================
## Kingbase 数据库配置 (替换 MySQL)
## ==========================
KINGBASE_HOST=192.168.10.29
KINGBASE_PORT=54321
KINGBASE_DB=test
# 注意：账号密码目前在 docker-compose ARGS 中硬编码，如需提取也可在此定义

## ==========================
## Server 运行参数
## ==========================
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom

# Redis 连接地址
# 注意: Docker 内部互联必须用服务名 "redis"，不能用 "127.0.0.1" 或外部 IP
REDIS_HOST=redis
REDIS_PASSWORD=yiwu_oa_redis

## ==========================
## 前端/Nginx 配置 (保留)
## ==========================
NODE_ENV=production
PUBLIC_PATH=/
VUE_APP_TITLE=芋道管理系统
VUE_APP_BASE_API=/prod-api
VUE_APP_APP_NAME=/
VUE_APP_TENANT_ENABLE=true
VUE_APP_CAPTCHA_ENABLE=true
VUE_APP_DOC_ENABLE=true
VUE_APP_BAIDU_CODE=fadc1bd5db1a1d6f581df60a1807f8ab